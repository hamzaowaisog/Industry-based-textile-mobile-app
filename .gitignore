# ==============================================================================
# HamzaTex .gitignore — Security-first: no secrets, no internal docs, no .md leaks
# ==============================================================================

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~

# ── Node.js / React Native ────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.expo/
.expo-shared/
web-build/
dist/
.metro-health-check*
*.jsbundle

# ── React Native signing & certificates ───────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ── iOS / Xcode ───────────────────────────────────────────────────────────────
ios/Pods/
ios/Podfile.lock
ios/build/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
*.moved-aside
DerivedData/
*.xccheckout
*.xcscmblueprint

# ── Android / IntelliJ ────────────────────────────────────────────────────────
android/.idea/
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.iml
*.hprof

# ── .NET / ASP.NET Core ──────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]ld/
[Ll]og/
[Ll]ogs/
artifacts/
project.lock.json
project.fragment.lock.json

# ── Visual Studio / Rider ─────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp

# ── NuGet ─────────────────────────────────────────────────────────────────────
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# ── Secrets & Credentials — NEVER commit ──────────────────────────────────────
*.secrets.json
*.secrets
secrets.json
.secrets/
**/secrets/
**/*.secret
**/*.secrets
*.pem
*.pfx
*.cer
*.crt
*.cert
*.key
*.p12
*.jks

# Firebase secrets
firebase-service-account.json
google-services.json
GoogleService-Info.plist

# ── Environment Files — NEVER commit ──────────────────────────────────────────
.env
.env.*
.envrc
!.env.example
!.env.template
!.env.sample

# ── AppSettings — contains connection strings, SMTP, JWT secrets ──────────────
appsettings.json
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
appsettings.*.json
# Keep example/template for reference:
# !appsettings.json.example
# !appsettings.template.json

# ── Connection strings / Database credentials ─────────────────────────────────
*connection*.json
*connection*.txt
*db*.json
*db*.txt
connectionstrings.json
database.json

# ── API Keys & Tokens ─────────────────────────────────────────────────────────
*apikey*.json
*apikey*.txt
*token*.json
*token*.txt
api-keys.json
tokens.json

# ── Azure / Cloud ─────────────────────────────────────────────────────────────
azure-*.json
*.azure.json
.azure/
azure-publish.json
azure-publish.xml

# ── Database files ────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Test Coverage ─────────────────────────────────────────────────────────────
coverage/
*.coverage
*.coveragexml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
*.log.*
logs/

# ── Backups & Temp ────────────────────────────────────────────────────────────
*.bak
*.backup
*.tmp
*.temp
*.swo
*_backup
*_old
.tmp/
.temp/
*.zip

# ── StyleCop ──────────────────────────────────────────────────────────────────
StyleCopReport.xml

# ── Graphify output ───────────────────────────────────────────────────────────
graphify-out/
.graphify_ast.json
.graphify_detect.json
.graphify_python
graphify-cache/

# ── Internal docs / planning / agent tooling — NOT for GitHub ─────────────────
todo/
planning/
docs/superpowers/
docs/mobile-design-prompt.md
_bmad-output/
_bmad/
.agent/
.cursor/commands/
CONTEXT.md
*.local.md

# ── Claude / Cursor local overrides ───────────────────────────────────────────
.claude/settings.local.json

# ── Portfolio / scratch content ───────────────────────────────────────────────
portfolio-content/

# ── Markdown: block ALL .md files, only allowlist below ───────────────────────
*.md

# ── ALLOWLIST — these .md files ARE tracked ───────────────────────────────────
!README.md
!CLAUDE.md
!frontend/CLAUDE.md
